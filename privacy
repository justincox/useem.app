<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Privacy Policy — em</title>
<!--
  /privacy exists only to send visitors to /privacy.html. GitHub Pages
  serves privacy.html for a request to /privacy when no exact file is
  here — this file overrides that fallback so the address bar actually
  lands on the canonical URL instead of quietly serving duplicate
  content under two paths.
-->
<meta http-equiv="refresh" content="0; url=https://useem.app/privacy.html">
<link rel="canonical" href="https://useem.app/privacy.html">
<meta name="robots" content="noindex, follow">
<style>body { margin: 0; background: #F6F1E4; color: #2b2b2b; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }</style>
<script>location.replace("https://useem.app/privacy.html");</script>
</head>
<body>
<p style="padding: 2rem;">Redirecting to <a href="https://useem.app/privacy.html">the Privacy Policy</a>…</p>
</body>
</html>
